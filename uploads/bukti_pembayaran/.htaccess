# Security hardening for uploaded payment proof files
# Allow users to view image/PDF proof files, but block script execution.

Options -Indexes

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .sh

<FilesMatch "\.(php|phtml|php[0-9]?|phar|cgi|pl|py|sh|asp|aspx|jsp)$">
    Require all denied
</FilesMatch>
